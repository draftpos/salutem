<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Settings Action -->
        <record id="action_salutem_config_settings" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'salutem'}</field>
        </record>

        <!-- Salutem Configuration Menu in Settings -->
        <menuitem id="menu_salutem_config_settings"
                  name="Salutem"
                  parent="base.menu_administration"
                  action="action_salutem_config_settings"
                  sequence="100"/>

        <!-- Config Settings View -->
        <record id="res_config_settings_view_form_salutem" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.salutem</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Salutem Configuration" string="Salutem" name="salutem" groups="base.group_system">
                        <block title="Dynamic Renaming" name="salutem_renaming">
                            <setting string="Customers" help="Rename 'Customers' to 'Members' globally">
                                <field name="rename_customers_to_members"/>
                            </setting>
                            <setting string="Sales" help="Rename 'Sales' to 'Contributions' globally">
                                <field name="rename_sales_to_contributions"/>
                            </setting>
                            <setting string="Products" help="Rename 'Products' to 'Subscription Packages' globally">
                                <field name="rename_products_to_subscription_packages"/>
                            </setting>
                            <setting string="Invoices" help="Rename 'Invoices' to 'Premiums' globally">
                                <field name="rename_invoices_to_premiums"/>
                            </setting>
                            <setting string="Product Variants" help="Rename 'Product Variants' to 'Subscription Variants' globally">
                                <field name="rename_product_variants_to_subscription_variants"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
